{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Values of k8s-scale-app-rs. A key that is not listed here is an error.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "description": "Helm passes this to every subchart.",
      "type": "object"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "$ref": "#/definitions/pullPolicy"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      }
    },
    "schedule": {
      "type": "string"
    },
    "suspend": {
      "type": "boolean"
    },
    "concurrencyPolicy": {
      "enum": [
        "Allow",
        "Forbid",
        "Replace"
      ]
    },
    "successfulJobsHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "failedJobsHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "backoffLimit": {
      "type": "integer",
      "minimum": 0
    },
    "mode": {
      "$ref": "#/definitions/mode"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/kind"
        },
        "deployment": {
          "type": "string"
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "dryRun": {
          "type": "boolean"
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "create": {
          "type": "boolean"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "$ref": "#/definitions/resources"
    },
    "podSecurityContext": {
      "$ref": "#/definitions/podSecurityContext"
    },
    "securityContext": {
      "$ref": "#/definitions/securityContext"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/toleration"
      }
    },
    "affinity": {
      "$ref": "#/definitions/affinity"
    },
    "extraCA": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingConfigMap": {
          "type": "string"
        },
        "bundle": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "mountPath": {
          "type": "string"
        }
      }
    },
    "logLevel": {
      "type": "string"
    },
    "vigil": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "$ref": "#/definitions/pullPolicy"
            }
          }
        },
        "jobs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "$ref": "#/definitions/mode"
              },
              "replicas": {
                "type": "integer",
                "minimum": 0
              },
              "name": {
                "type": "string"
              },
              "kind": {
                "$ref": "#/definitions/kind"
              },
              "dryRun": {
                "type": "boolean"
              },
              "runTimeout": {
                "type": "string"
              },
              "schedule": {
                "type": "string"
              },
              "scheduleTz": {
                "type": "string"
              }
            }
          }
        },
        "identities": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "access": {
                "enum": [
                  "metrics",
                  "read",
                  "write",
                  "admin"
                ]
              },
              "basic": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "existingSecret": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  }
                }
              },
              "tls": {
                "type": "boolean"
              }
            }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "clientCA": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "existingSecret": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            },
            "anonymousAccess": {
              "enum": [
                "open",
                "metrics"
              ]
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "openshift": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "route": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "host": {
                  "type": "string"
                },
                "termination": {
                  "enum": [
                    "passthrough",
                    "reencrypt"
                  ]
                },
                "destinationCACertificate": {
                  "type": "string"
                },
                "annotations": {
                  "type": "object"
                }
              }
            }
          }
        },
        "gatewayApi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "routeType": {
              "enum": [
                "http",
                "tls"
              ]
            },
            "parentRefs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "group": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "namespace": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "sectionName": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                }
              }
            },
            "hostnames": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "path": {
              "type": "string"
            },
            "backendTLS": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "hostname": {
                  "type": "string"
                },
                "caConfigMap": {
                  "type": "string"
                }
              }
            }
          }
        },
        "runTimeout": {
          "type": "string"
        },
        "watchLayers": {
          "type": "string"
        },
        "resources": {
          "$ref": "#/definitions/resources"
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    }
  },
  "definitions": {
    "mode": {
      "enum": [
        "scale",
        "restart"
      ]
    },
    "kind": {
      "enum": [
        "deployment",
        "statefulset"
      ]
    },
    "pullPolicy": {
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "type": "object"
        },
        "requests": {
          "type": "object"
        },
        "claims": {
          "type": "array"
        }
      }
    },
    "seccompProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "RuntimeDefault",
            "Unconfined",
            "Localhost"
          ]
        },
        "localhostProfile": {
          "type": "string"
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appArmorProfile": {
          "type": "object"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seLinuxOptions": {
          "type": "object"
        },
        "seccompProfile": {
          "$ref": "#/definitions/seccompProfile"
        },
        "windowsOptions": {
          "type": "object"
        },
        "fsGroup": {
          "type": "integer"
        },
        "fsGroupChangePolicy": {
          "type": "string"
        },
        "seLinuxChangePolicy": {
          "type": "string"
        },
        "supplementalGroups": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "supplementalGroupsPolicy": {
          "type": "string"
        },
        "sysctls": {
          "type": "array"
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appArmorProfile": {
          "type": "object"
        },
        "runAsGroup": {
          "type": "integer"
        },
        "runAsNonRoot": {
          "type": "boolean"
        },
        "runAsUser": {
          "type": "integer"
        },
        "seLinuxOptions": {
          "type": "object"
        },
        "seccompProfile": {
          "$ref": "#/definitions/seccompProfile"
        },
        "windowsOptions": {
          "type": "object"
        },
        "allowPrivilegeEscalation": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "add": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "drop": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "privileged": {
          "type": "boolean"
        },
        "procMount": {
          "type": "string"
        },
        "readOnlyRootFilesystem": {
          "type": "boolean"
        }
      }
    },
    "toleration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "effect": {
          "type": "string"
        },
        "tolerationSeconds": {
          "type": "integer"
        }
      }
    },
    "affinity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeAffinity": {
          "type": "object"
        },
        "podAffinity": {
          "type": "object"
        },
        "podAntiAffinity": {
          "type": "object"
        }
      }
    }
  }
}
