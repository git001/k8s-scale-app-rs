vtest "a 404 from the API: exit code 1 with the Deployment and the reason"

server s1 -repeat 2 {
	rxreq
	expect req.url ~ "/namespaces/demo/deployments/web"
	txresp -status 404 -hdr "Content-Type: application/json" -bodyfrom ${vtestdir}/fixtures/not-found.json
} -start

# The server listens on a free port; the kubeconfig is the static fixture with that port.
shell {sed "s/26443/${s1_port}/" ${vtestdir}/fixtures/kubeconfig.yaml > ${tmpdir}/kubeconfig}

shell -exit 1 -match {failed to patch scale for demo/web(.|\n)*not found} {
	KUBECONFIG=${tmpdir}/kubeconfig NO_COLOR=1 \
	${k8s_scale} scale --deployment web --namespace demo --replicas 3
}

shell -exit 1 -match {failed to patch deployment demo/web(.|\n)*not found} {
	KUBECONFIG=${tmpdir}/kubeconfig NO_COLOR=1 \
	${k8s_scale} restart --deployment web --namespace demo
}

server s1 -wait
