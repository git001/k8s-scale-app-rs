vtest "K8S_SCALE_* environment variables, the way the CronJob configures the CLI"

server s1 {
	rxreq
	expect req.url ~ "^/apis/apps/v1/namespaces/demo/deployments/web/scale[?]"
	expect req.url ~ "dryRun=All"
	expect req.body == {{"spec":{"replicas":3}}}
	txresp -hdr "Content-Type: application/json" -bodyfrom ${vtestdir}/fixtures/scale-3.json
} -start

# The server listens on a free port; the kubeconfig is the static fixture with that port.
shell {sed "s/26443/${s1_port}/" ${vtestdir}/fixtures/kubeconfig.yaml > ${tmpdir}/kubeconfig}

shell -match {scale request completed .*replicas=3 dry_run=true} {
	KUBECONFIG=${tmpdir}/kubeconfig \
	K8S_SCALE_DEPLOYMENT=web K8S_SCALE_NAMESPACE=demo \
	K8S_SCALE_REPLICAS=3 K8S_SCALE_DRY_RUN=true \
	${k8s_scale} scale
}

server s1 -wait
